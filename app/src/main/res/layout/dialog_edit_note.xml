<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nickname"
        android:textColor="@color/text_high"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_dialog_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Sparky"
        android:inputType="textPersonName"
        android:minHeight="48dp"
        android:textColor="@color/text_high"
        android:textColorHint="@color/text_low"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personal Note"
        android:textColor="@color/text_high"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_dialog_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. Caught this Pikachu on my trip to Japan!"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:gravity="top"
        android:textColor="@color/text_high"
        android:textColorHint="@color/text_low" />
</LinearLayout>
